{
  "name": "@thisisjuke/skillbench-web",
  "version": "0.2.0",
  "description": "Local persistent Web interface for Skillbench",
  "homepage": "https://github.com/Thisisjuke/skills-benchmark/tree/main/apps/web#readme",
  "bugs": {
    "url": "https://github.com/Thisisjuke/skills-benchmark/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thisisjuke/skills-benchmark.git",
    "directory": "apps/web"
  },
  "bin": {
    "skillbench-web": "./dist/server.mjs"
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "migrations:check": "node scripts/check-migrations.mjs",
    "start": "node dist/server.mjs",
    "test": "vp run build && vp test run --passWithNoTests",
    "check": "vp run migrations:check && vp run build && tsc --noEmit && vp test run --passWithNoTests"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/geist": "5.3.0",
    "@hono/node-server": "2.1.1",
    "@hono/zod-validator": "0.9.1",
    "@tanstack/react-query": "5.102.8",
    "@thisisjuke/skillbench": "workspace:*",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.6",
    "commander": "catalog:",
    "drizzle-orm": "0.45.2",
    "execa": "catalog:",
    "hono": "4.13.7",
    "lucide-react": "1.41.0",
    "open": "11.0.2",
    "p-queue": "9.3.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tw-animate-css": "1.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/better-sqlite3": "9.6.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.10",
    "jsdom": "30.0.1",
    "publint": "catalog:",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.0"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
