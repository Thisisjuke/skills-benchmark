{
  "name": "@skillbench/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Portable Skillbench contracts and use cases",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./assertions": "./dist/assertions/index.mjs",
    "./bundles": "./dist/bundles/index.mjs",
    "./comparator": "./dist/comparator/index.mjs",
    "./errors": "./dist/errors.mjs",
    "./evaluator": "./dist/evaluator/index.mjs",
    "./holdout": "./dist/holdout/index.mjs",
    "./inspect": "./dist/inspect.mjs",
    "./judge": "./dist/judge/index.mjs",
    "./logging": "./dist/logging/index.mjs",
    "./merger": "./dist/merger/index.mjs",
    "./reports": "./dist/reports/index.mjs",
    "./results": "./dist/results/index.mjs",
    "./runners": "./dist/runners/index.mjs",
    "./skills": "./dist/skills/index.mjs",
    "./sources": "./dist/sources/index.mjs",
    "./sources/local": "./dist/sources/local.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "vp run build && tsc --noEmit",
    "test": "vp run build && vp test run --passWithNoTests",
    "check": "vp run build && tsc --noEmit && vp test run --passWithNoTests"
  },
  "dependencies": {
    "@skillbench/invocation-contract": "workspace:*",
    "execa": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "publint": "catalog:"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
